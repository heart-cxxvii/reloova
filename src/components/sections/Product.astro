---
const features = [
  {
    title: "活動記録",
    text: "練習内容やトレーニング履歴を蓄積し、チームと選手の歩みを継続的に確認。",
    icon: "record",
  },
  {
    title: "コンディション管理",
    text: "疲労度・体調・怪我などを記録し、教員や外部指導者と共有。",
    icon: "condition",
  },
  {
    title: "動作フィードバック",
    text: "動画から姿勢や動作を分析し、日々のフォームを振り返る。",
    icon: "motion",
  },
  {
    title: "チーム運営",
    text: "学校・教員・外部指導者・生徒の情報をひとつにつなぐ。",
    icon: "team",
  },
];
---

<section
  id="product"
  class="section product-section"
  aria-labelledby="product-title"
>
  <div class="container">
    <div class="product-intro">
      <div class="section-intro">
        <p class="eyebrow">PRODUCT</p>
        <h2 id="product-title">
          日々の活動を、
          <br />
          次の価値につなげる。
        </h2>
        <p class="section-description">
          学校・地域クラブ向けの仕組みで、活動記録、選手の状態、動作、チーム運営をひとつにつなぎます。
        </p>
      </div>
      <img
        class="product-photo"
        src="/assets/images/team-coaching.jpg"
        alt="スポーツ施設で選手たちに話すコーチ"
        width="1800"
        height="2700"
        loading="lazy"
      />
    </div>
    <div class="feature-grid">
      {features.map(({ title, text, icon }) => (
        <article class="feature-card">
          <span class="feature-icon" aria-hidden="true">
            <svg
              width="28"
              height="28"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              {icon === "record" && (
                <>
                  <rect x="5" y="4" width="14" height="17" rx="2" />
                  <path d="M9 3h6v3H9zM9 11h6M9 15h6" />
                </>
              )}
              {icon === "condition" && (
                <>
                  <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z" />
                  <path d="M4 12h4l2-4 3 8 2-4h5" />
                </>
              )}
              {icon === "motion" && (
                <>
                  <rect x="3" y="4" width="18" height="16" rx="3" />
                  <path d="m10 8 6 4-6 4V8Z" />
                </>
              )}
              {icon === "team" && (
                <>
                  <circle cx="9" cy="8" r="3" />
                  <path d="M3 21v-2a6 6 0 0 1 12 0v2M16 5a3 3 0 0 1 0 6M21 21v-2a6 6 0 0 0-3-5.2" />
                </>
              )}
            </svg>
          </span>
          <h3>{title}</h3>
          <p>{text}</p>
          {icon === "motion" && (
            <a class="motion-demo-link" href="/motion-lab/">
              動作解析デモを見る <span aria-hidden="true">→</span>
            </a>
          )}
        </article>
      ))}
    </div>
    <p class="section-note">掲載している機能は構想・開発予定です。</p>
  </div>
</section>

<style>
  .motion-demo-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: 20px;
    font-size: 14px;
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 5px;
  }
</style>
