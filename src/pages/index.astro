---
import BaseLayout from "../layouts/BaseLayout.astro";

const features = [
  ["01", "活動記録", "練習内容やトレーニング履歴を蓄積し、チームと選手の歩みを継続的に確認。"],
  ["02", "コンディション管理", "疲労度・体調・怪我などを記録し、教員や外部指導者と共有。"],
  ["03", "動作フィードバック", "動画から姿勢や動作を分析し、日々のフォームを振り返る。"],
  ["04", "チーム運営", "学校・教員・外部指導者・生徒の情報をひとつにつなぐ。"],
];

const stakeholders = [
  ["生徒・選手", "成長とコンディションを振り返り、安全な競技継続へ。"],
  ["教員・外部指導者", "情報を一元化し、立場をまたいだ共有と安全管理へ。"],
  ["学校・地域クラブ", "運営情報と活動記録をつなぎ、現場の負担軽減へ。"],
  ["大学・研究者", "継続的な運動データを、研究に活かせる環境へ。"],
];
---

<BaseLayout>
  <header class="sticky top-0 z-50 border-b border-slate-200 bg-white/90 backdrop-blur-xl">
    <div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-5 lg:px-8">
      <a href="#top" class="block w-36 sm:w-40" aria-label="RELOOVA トップへ">
        <img src="/assets/images/reloova-logo-primary.png" alt="RELOOVA" />
      </a>
      <nav class="hidden items-center gap-8 text-sm font-semibold md:flex" aria-label="メインナビゲーション">
        <a href="#problem" class="transition-colors hover:text-main">課題</a>
        <a href="#product" class="transition-colors hover:text-main">プロダクト</a>
        <a href="#model" class="transition-colors hover:text-main">事業モデル</a>
        <a href="#founder" class="transition-colors hover:text-main">代表者</a>
      </nav>
      <a href="#contact" class="rounded-lg bg-main px-4 py-3 text-xs font-bold text-white shadow-lg shadow-blue-200 sm:px-5 sm:text-sm">お問い合わせ</a>
    </div>
  </header>

  <main id="top" class="bg-white text-slate-950 antialiased">
    <section class="overflow-hidden bg-custom-blue-100 py-20 lg:py-32">
      <div class="mx-auto max-w-7xl px-5 lg:px-8">
        <div class="max-w-5xl">
          <p class="mb-5 text-xs font-extrabold tracking-[.22em] text-main">SPORTS DATA × RESEARCH × EDUCATION</p>
          <h1 class="text-5xl font-bold leading-[1.08] tracking-[-.055em] sm:text-6xl lg:text-7xl">部費ゼロの部活動を、<br /><span class="text-main">運動データ</span>でつくる。</h1>
          <p class="mt-7 max-w-2xl text-base leading-8 text-slate-600 lg:text-lg">スポーツ現場で生まれるデータを研究・製品開発につなぎ、その価値を再びスポーツ現場へ。</p>
          <div class="mt-9 flex flex-wrap gap-4">
            <a href="#problem" class="rounded-lg bg-main px-6 py-4 text-sm font-bold text-white shadow-lg shadow-blue-200">RELOOVAについて →</a>
            <a href="#model" class="rounded-lg border border-slate-400 bg-white px-6 py-4 text-sm font-bold">事業概要を見る</a>
          </div>
        </div>
      </div>
    </section>

    <section id="problem" class="py-20 lg:py-28">
      <div class="mx-auto max-w-7xl px-5 lg:px-8">
        <p class="mb-4 text-xs font-extrabold tracking-[.2em] text-main">01 / PROBLEM</p>
        <h2 class="max-w-5xl text-4xl font-bold leading-tight tracking-[-.045em] sm:text-5xl lg:text-6xl">スポーツ現場と研究開発。<br />離れた課題を、ひとつの循環へ。</h2>
        <div class="mt-12 grid gap-6 lg:grid-cols-2">
          <article class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm lg:p-10">
            <p class="mb-8 text-xs font-bold tracking-[.18em] text-main">SPORTS FIELD</p>
            <h3 class="text-3xl font-bold">スポーツ現場の課題</h3>
            <div class="mt-8 space-y-6">
              <div class="border-t border-slate-200 pt-5"><h4 class="mb-2 text-lg font-bold">活動費の負担</h4><p class="text-sm leading-7 text-slate-600">部費、用品費、ユニフォーム、遠征費、大会参加費などが家庭や現場に積み重なる。</p></div>
              <div class="border-t border-slate-200 pt-5"><h4 class="mb-2 text-lg font-bold">情報の分断</h4><p class="text-sm leading-7 text-slate-600">教員、外部指導者、地域クラブの間で活動内容や選手の状態を共有しにくい。</p></div>
            </div>
          </article>
          <article class="rounded-3xl border border-slate-200 bg-custom-light-100 p-8 shadow-sm lg:p-10">
            <p class="mb-8 text-xs font-bold tracking-[.18em] text-main">RESEARCH &amp; R&amp;D</p>
            <h3 class="text-3xl font-bold">研究開発の課題</h3>
            <div class="mt-8 space-y-6">
              <div class="border-t border-slate-200 pt-5"><h4 class="mb-2 text-lg font-bold">継続的なデータの不足</h4><p class="text-sm leading-7 text-slate-600">研究・製品開発に必要な運動データを一定規模で確保することが難しい。</p></div>
              <div class="border-t border-slate-200 pt-5"><h4 class="mb-2 text-lg font-bold">収集・整備コスト</h4><p class="text-sm leading-7 text-slate-600">被験者募集、測定、日程調整、データ管理・加工に時間と設備が必要になる。</p></div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section id="product" class="bg-custom-blue-300 py-20 text-white lg:py-28">
      <div class="mx-auto max-w-7xl px-5 lg:px-8">
        <div class="grid gap-10 lg:grid-cols-[.8fr_1.2fr] lg:items-end">
          <div><p class="mb-4 text-xs font-extrabold tracking-[.2em] text-blue-300">02 / PRODUCT</p><h2 class="text-4xl font-bold leading-tight tracking-[-.04em] text-white sm:text-5xl">日々の活動を、<br />次の価値につなげる。</h2></div>
          <p class="max-w-2xl text-base leading-8 text-blue-100">学校・地域クラブ向けの仕組みで、活動記録、選手の状態、動作、チーム運営をひとつにつなぎます。</p>
        </div>
        <div class="mt-12 grid gap-5 sm:grid-cols-2">
          {features.map(([number, title, text]) => <article class="rounded-2xl border border-white/15 bg-white/10 p-7 backdrop-blur"><span class="text-xs font-bold text-blue-300">{number}</span><h3 class="mt-5 text-2xl font-bold text-white">{title}</h3><p class="mt-3 text-sm leading-7 text-blue-100">{text}</p></article>)}
        </div>
      </div>
    </section>

    <section id="model" class="bg-custom-light-100 py-20 lg:py-28">
      <div class="mx-auto max-w-7xl px-5 lg:px-8">
        <p class="mb-4 text-xs font-extrabold tracking-[.2em] text-main">03 / BUSINESS MODEL</p>
        <h2 class="max-w-4xl text-4xl font-bold leading-tight tracking-[-.04em] sm:text-5xl">データの価値が、<br />スポーツ現場にめぐる仕組みへ。</h2>
        <div class="mt-12 grid gap-5 lg:grid-cols-[1fr_auto_1fr_auto_1fr] lg:items-center">
          <article class="overflow-hidden rounded-2xl bg-white shadow-sm"><img src="/assets/images/school-club.webp" alt="学校・地域クラブ" class="h-40 w-full object-cover" /><div class="p-7"><span class="text-xs font-bold text-main">SPORTS FIELD</span><h3 class="mt-4 text-2xl font-bold">学校・地域クラブ</h3><p class="mt-3 text-sm leading-7 text-slate-600">日々の活動でサービスを利用し、記録を蓄積。</p></div></article>
          <span class="hidden text-3xl text-main lg:block" aria-hidden="true">→</span>
          <article class="rounded-2xl bg-main p-8 text-white shadow-xl shadow-blue-200"><img src="/assets/images/reloova-logo-primary.png" alt="RELOOVA" class="mb-8 w-36 brightness-0 invert" /><h3 class="text-2xl font-bold text-white">記録を蓄積・加工</h3><p class="mt-4 text-sm leading-7 text-blue-100">適切な同意を前提に、研究・開発用途へ活かせる形に。</p></article>
          <span class="hidden text-3xl text-main lg:block" aria-hidden="true">→</span>
          <article class="overflow-hidden rounded-2xl bg-white shadow-sm"><img src="/assets/images/research-lab.jpg" alt="研究機関・企業" class="h-40 w-full object-cover" /><div class="p-7"><span class="text-xs font-bold text-main">RESEARCH &amp; BUSINESS</span><h3 class="mt-4 text-2xl font-bold">研究機関・企業</h3><p class="mt-3 text-sm leading-7 text-slate-600">大学、研究機関、スポーツ・ヘルスケア企業等。</p></div></article>
        </div>
        <div class="mt-6 rounded-2xl bg-cyan-300 p-6 text-slate-950 lg:flex lg:items-center lg:gap-12"><strong class="text-xs tracking-[.16em]">RETURN TO THE FIELD</strong><p class="mt-3 text-sm font-semibold leading-7 lg:mt-0">B2B収益の一部を、備品・ユニフォーム・遠征費・大会参加費など、スポーツ現場の負担軽減へ。</p></div>
      </div>
    </section>

    <section class="py-20 lg:py-28">
      <div class="mx-auto max-w-7xl px-5 lg:px-8">
        <p class="mb-4 text-xs font-extrabold tracking-[.2em] text-main">04 / STAKEHOLDERS</p>
        <h2 class="text-4xl font-bold tracking-[-.04em] sm:text-5xl">それぞれの現在を、次の状態へ。</h2>
        <div class="mt-10 divide-y divide-slate-200 border-y border-slate-200">
          {stakeholders.map(([name, text], index) => <div class="grid gap-3 py-6 md:grid-cols-[80px_220px_1fr] md:items-center"><span class="text-xs font-bold text-main">0{index + 1}</span><strong class="text-lg">{name}</strong><p class="text-sm leading-7 text-slate-600">{text}</p></div>)}
        </div>
      </div>
    </section>

    <section id="founder" class="bg-custom-light-100 py-20 lg:py-28">
      <div class="mx-auto max-w-4xl px-5 lg:px-8">
        <p class="mb-4 text-xs font-extrabold tracking-[.2em] text-main">05 / FOUNDER</p>
        <p class="text-sm font-bold text-slate-500">RELOOVA 代表</p>
        <h2 class="mt-2 text-5xl font-bold tracking-[-.05em]">Shin Machizuka</h2>
        <p class="mt-6 text-xl font-bold leading-9">大学で教育と運動生理学、大学院でバイオメカニクス、企業でデータ基盤。<br />3つの経験をつなぎ、RELOOVAを構想。</p>
        <div class="mt-10 divide-y divide-slate-200 border-y border-slate-200 text-sm">
          <div class="grid gap-3 py-5 md:grid-cols-[120px_1fr]"><strong class="text-main">BACHELOR</strong><span>中学校・高等学校の保健体育および特別支援学校の教員免許取得<br />運動生理学・運動処方演習を学び、運動処方学研究室に所属</span></div>
          <div class="grid gap-3 py-5 md:grid-cols-[120px_1fr]"><strong class="text-main">MASTER</strong><span>大学院ではバイオメカニクスを専攻。動作解析を用いて人の動きを分析・研究</span></div>
          <div class="grid gap-3 py-5 md:grid-cols-[120px_1fr]"><strong class="text-main">CAREER</strong><span>Analytics Engineerとしてデータ基盤に関わる業務に従事</span></div>
        </div>
      </div>
    </section>

    <section id="contact" class="bg-custom-blue-300 py-20 text-white lg:py-24">
      <div class="mx-auto grid max-w-7xl gap-10 px-5 lg:grid-cols-2 lg:items-end lg:px-8">
        <div><p class="mb-4 text-xs font-extrabold tracking-[.2em] text-blue-300">06 / CONTACT</p><h2 class="text-5xl font-bold tracking-[-.05em] text-white sm:text-6xl">ご連絡・<br />お問い合わせ先</h2></div>
        <a href="mailto:machi2001shin@icloud.com" class="group border-y border-white/25 py-6"><span class="text-xs text-blue-200">お問い合わせ</span><div class="mt-2 flex items-center justify-between gap-4 text-xl font-bold sm:text-2xl"><span class="break-all">machi2001shin@icloud.com</span><span class="text-cyan-300 transition-transform group-hover:-translate-y-1 group-hover:translate-x-1" aria-hidden="true">↗</span></div></a>
      </div>
    </section>
  </main>

  <footer class="bg-slate-950 py-7 text-white">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 px-5 lg:px-8">
      <img src="/assets/images/reloova-logo-primary.png" alt="RELOOVA" class="w-32 brightness-0 invert" />
      <small class="text-slate-400">© 2026 RELOOVA.</small>
    </div>
  </footer>
</BaseLayout>
