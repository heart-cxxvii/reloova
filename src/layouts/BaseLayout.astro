---
import "../styles/global.css";

const title = "RELOOVA｜部費ゼロの部活動を、運動データでつくる";
const description = "RELOOVAは、学校・地域クラブを支える無償SaaSと運動データの研究開発活用を通じ、スポーツ現場への価値還元を目指す構想段階の事業です。";
const ogDescription = "学校・地域クラブを支える無償SaaS。運動データを研究開発につなぎ、その価値をスポーツ現場へ還元する仕組みを目指しています。";
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content="RELOOVA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content="/assets/images/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/assets/favicon.png" type="image/png" sizes="128x128" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
